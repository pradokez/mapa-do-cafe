# Supabase — Project Settings › API Keys
# Só servidor: o cafe-repository roda em Server Components, então nada aqui
# leva o prefixo NEXT_PUBLIC_ (que exporia a variável no bundle do navegador).
SUPABASE_URL=
# Publishable key (sb_publishable_...). Leitura pública, sujeita à RLS.
SUPABASE_PUBLISHABLE_KEY=

# A sessão do admin usa a mesma publishable key: quem decide o acesso é a RLS.
# O JWKS (verificação do JWT no middleware) sai do próprio SUPABASE_URL.

# Fora do app, de propósito: a secret key ignora a RLS. Só para scripts locais
# (ex.: seed) — src/lib/fronteiras.test.ts falha se ela aparecer em src/.
SUPABASE_SECRET_KEY=

# Mapbox — account.mapbox.com › Tokens. Token público (pk.…), nunca um sk.…
# Vai para o navegador por design (o Mapbox GL roda no cliente). Sem restrição
# de URL: a conta gratuita não permite (ver "Domínio" no CLAUDE.md). Não
# cadastre cartão no Mapbox sem antes restringir o token.
# Embutido no bundle no build — mudou na Vercel, precisa de novo deploy.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Origem das URLs absolutas: metadataBase, canonical, sitemap e JSON-LD — e
# destino do redirect do *.vercel.app em produção. Na Vercel (Production):
# https://mapadocafe-pe.com.br; em Preview, vazia.
# Sem barra no fim, com protocolo (https://…). Vazia: domínio de produção da
# Vercel (VERCEL_PROJECT_PRODUCTION_URL, injetada por ela) ou, fora da Vercel,
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Modo leitura do admin (#75). Não há banco local: o dev aponta para a produção.
# Fora da produção da Vercel (VERCEL_ENV=production), as Server Actions de
# escrita do admin recusam gravar; só o valor exato 1 libera. Use quando a
# intenção for mesmo gravar na produção a partir daqui. Nunca configure na
# Vercel (nos previews, que também apontam para a produção, fica desligada).
# Sem NEXT_PUBLIC_: a decisão é só do servidor.
ADMIN_ESCRITA_LIBERADA=

# Sugestões do público (#83): segredo do HMAC do IP, para o limite de 5
# envios por hora sem guardar o IP (o hash some em 24 h). Gere com
# `openssl rand -hex 32`. Na Vercel, em Production e Preview; sem ela, o envio
# falha fechado (não grava sem o limite valer). Trocar o valor só zera os
# limites em curso. Sem NEXT_PUBLIC_: nunca vai para o navegador.
SUGESTOES_IP_SECRET=
