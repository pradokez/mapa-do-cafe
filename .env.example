# Supabase — Project Settings › API Keys
# Só servidor: o cafe-repository roda em Server Components, então nada aqui
# leva o prefixo NEXT_PUBLIC_ (que exporia a variável no bundle do navegador).
SUPABASE_URL=
# Publishable key (sb_publishable_...). Leitura pública, sujeita à RLS.
SUPABASE_PUBLISHABLE_KEY=

# Ainda não usadas pelo app — reservadas para o admin (Fase 2).
# A secret key ignora a RLS: nunca use para leitura pública.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Mapbox — account.mapbox.com › Tokens. Token público (pk.…), nunca um sk.…
# Vai para o navegador por design (o Mapbox GL roda no cliente): restrinja por
# URL no painel (localhost + domínios da Vercel). Embutido no bundle no build —
# mudou na Vercel, precisa de novo deploy.
NEXT_PUBLIC_MAPBOX_TOKEN=
